# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pytype/

# Jupyter
.ipynb_checkpoints/

# Editors / IDEs
.vscode/
.idea/
*.swp

# Claude Code local settings/tooling - not needed to run or understand the
# app, and CLAUDE.md documents internal AI-assisted-dev history/rationale
# not meant for the public student-facing repo. Kept on disk locally (not
# deleted) so future Claude Code sessions in this working copy still have
# them - just excluded from what gets pushed.
/.claude/
/CLAUDE.md

# OS files
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
*.pem
*.key
secrets.*

# Licensed reference documents (e.g. SIA norm PDFs) - copyrighted,
# licensed to an individual/institution, not for redistribution via git
/grundlagen/

# Pre-adaptation shell_layer reference material (examples, validation
# experiments, GUI prototype, shell-only tests) - not part of the active
# beam_layer package and not needed by students; kept on disk locally as
# reference (see CLAUDE.md) but excluded from the public repo.
/legacy_shell_layer/

# Local dev-server run logs (contain local machine/network details -
# hostnames, local network IPs - not meant for a public repo)
*.log

# Data files (results, inputs, exports)
*.csv
*.xlsx
*.xls
*.h5
*.hdf5
*.npy
*.npz
/data/
/results/
/output/
